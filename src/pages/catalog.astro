---
import Base from "../layouts/Base.astro";
import ItemExample from "../components/ItemExample.astro";
import { loadLlmsGroups } from "../lib/kit.mjs";

const groups = loadLlmsGroups();
const count = groups.reduce((sum, g) => sum + g.items.length, 0);
---
<Base title="Catalog - uiforagents">
  <div class="page">
    <header class="page-head">
      <h1>Catalog</h1>
      <p>Every one of the {count} items, live, rendered in the current direction. This is the kit's
      build-time arena promoted to a product surface: same components, same tokens, no iframes.
      Flip the direction switcher to restyle everything in place.</p>
    </header>
    {groups.map((group) => (
      <section class="catalog-section">
        <h2 style={`text-transform: capitalize;`} id={`category-${group.category}`}>{group.category}</h2>
        {group.items.map((item) => (
          <section class="catalog-item" id={item.name}>
            <div class="catalog-head">
              <h3>{item.title}</h3>
              <span class="catalog-name">{item.name}</span>
              <a href={`/components/${item.name}/`}>Docs</a>
            </div>
            <p class="catalog-desc">{item.description}</p>
            <div class="catalog-stage">
              <ItemExample name={item.name} />
            </div>
          </section>
        ))}
      </section>
    ))}
  </div>
</Base>
