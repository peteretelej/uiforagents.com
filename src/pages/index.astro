---
import Base from "../layouts/Base.astro";
import IdentityCard from "../components/IdentityCard.astro";
import IdentityTile from "../components/IdentityTile.astro";
import { loadIdentities } from "../lib/identities.mjs";
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-500.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/inter/latin-700.css";
import "@fontsource/plus-jakarta-sans/latin-600.css";
import "@fontsource/plus-jakarta-sans/latin-700.css";
import "@fontsource/plus-jakarta-sans/latin-800.css";
import "../styles/site.css";

const identities = loadIdentities();
const featured = identities.slice(0, 3);
const lanes = [...new Set(identities.map((i) => i.lane))].sort();
const tags = [...new Set(identities.flatMap((i) => i.spec.vibe))].sort();
const catalogueCount = `${identities.length} ${identities.length === 1 ? "identity" : "identities"}`;

const installCmd = `npx shadcn add https://uiforagents.com/r/ocean-calm.json`;
const installConfig = JSON.stringify(
  {
    registries: {
      "@uiforagents": "https://uiforagents.com/r/{name}.json",
    },
  },
  null,
  2
);
const importExample = `@import "tailwindcss";
@import "./identities/ocean-calm/theme/theme.css";
@import "./identities/ocean-calm/overrides/overrides.css";`;
const rootExample = `<div data-theme="ocean-calm" data-identity="ocean-calm">
  <!-- your app -->
</div>`;
---
<Base>
  <div class="container">
    <section class="hero">
      <p class="eyebrow">Open-source design systems</p>
      <h1>Design identities for agent-built apps</h1>
      <p class="lede">
        Complete, opinionated design systems on shadcn/ui - tokens, component treatments, blocks,
        fonts, and motion, bundled with the prompt-pack your agent follows. Pick an identity, install
        it with one command, and ship product without making a single design decision.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href="#identities">Browse identities</a>
        <a class="btn btn-ghost" href="#how">Usage guide</a>
      </div>
    </section>

    <section class="catalogue" id="identities" aria-label="Identity catalogue">
      <div class="catalogue-inner">
        <div class="section-head">
          <p class="eyebrow">The catalogue</p>
          <h2>{catalogueCount}, ready to ship</h2>
          <p>Every card below is live: it carries its identity's own color. Open one to see its full suite (React) or demo and foundation stylesheet (pure-CSS artifact), and grab its agent prompt-pack.</p>
        </div>

        <div class="featured-grid">
          {featured.map((identity) => <IdentityCard {identity} />)}
        </div>

        <div class="filter-bar" role="group" aria-label="Filter identities">
          <div class="filter-row">
            <input
              type="search"
              id="identity-search"
              placeholder="Search identities..."
              aria-label="Search identities"
              autocomplete="off"
            />
            <div class="lane-toggle" role="group" aria-label="Filter by lane">
              <button type="button" class="lane-btn is-active" data-lane="all" aria-pressed="true">All</button>
              {lanes.map((lane) => (
                <button type="button" class="lane-btn" data-lane={lane} aria-pressed="false">{lane}</button>
              ))}
            </div>
          </div>
          <div class="tag-row" role="group" aria-label="Filter by vibe">
            {tags.map((tag) => (
              <button type="button" class="tag-btn" data-tag={tag} aria-pressed="false">{tag}</button>
            ))}
          </div>
        </div>

        <p class="result-count" id="identity-count" aria-live="polite">
          Showing all {identities.length} {identities.length === 1 ? "identity" : "identities"}
        </p>

        <div class="identity-tiles" id="identity-grid">
          {identities.map((identity) => <IdentityTile {identity} />)}
        </div>

        <div class="empty-state" id="identity-empty" hidden>
          <p>No identities match those filters.</p>
          <button type="button" class="btn btn-ghost" id="identity-clear">Clear filters</button>
        </div>
      </div>
    </section>

    <section class="section" id="how" aria-label="Usage guide">
      <div class="section-head">
        <p class="eyebrow">Usage guide</p>
        <h2>Build with an identity</h2>
        <p>The whole flow, start to finish. Point your agent at this section - it doubles as the binding instructions.</p>
      </div>
      <div class="steps">
        <div class="step">
          <span class="num">01</span>
          <h3>Read the prompt-pack first</h3>
          <p>Each identity's <a href="/prompt-packs/ocean-calm.md">prompt-pack.md</a> is the binding design contract: fonts, color rules, density, motion, do/don'ts. Follow it exactly - no visual improvisation.</p>
        </div>
        <div class="step">
          <span class="num">02</span>
          <h3>Install the identity</h3>
          <pre class="code-block"><code>{installCmd}</code></pre>
          <p>Or register the <code>@uiforagents</code> namespace once (see Install below) and add by name.</p>
        </div>
        <div class="step">
          <span class="num">03</span>
          <h3>Import theme and overrides after Tailwind</h3>
          <p>In your Tailwind entry, import the identity's <code>theme/theme.css</code> AND <code>overrides/overrides.css</code>, after the Tailwind import:</p>
          <pre class="code-block"><code>{importExample}</code></pre>
        </div>
        <div class="step">
          <span class="num">04</span>
          <h3>Start from blocks, adapt content</h3>
          <p>Compose pages from the identity's <code>blocks/*.tsx</code> and swap in your content. Brand happens through tokens and your logo - never by restyling identity components per project.</p>
        </div>
        <div class="step">
          <span class="num">05</span>
          <h3>Carry both attributes on the root</h3>
          <p>Put <code>data-theme="&lt;slug&gt;"</code> and <code>data-identity="&lt;slug&gt;"</code> on the same identity root element. Theme tokens key on <code>[data-theme]</code> - nairobi-noon ships no other scope - and overrides key on <code>[data-identity]</code>. With only one attribute, half the system stays dormant.</p>
          <pre class="code-block"><code>{rootExample}</code></pre>
        </div>
        <div class="step">
          <span class="num">06</span>
          <h3>Install fonts via @fontsource</h3>
          <p>Identities name their fonts in the spec and prompt-pack; install them as <code>@fontsource</code> packages and import the weights the pack lists.</p>
        </div>
      </div>
    </section>

    <section class="section" id="install" aria-label="Install">
      <div class="section-head">
        <p class="eyebrow">Install</p>
        <h2>One command into any shadcn app</h2>
        <p>Tailwind v4 + React 18+. Swap the slug in the URL for any identity in the catalogue.</p>
      </div>
      <div class="stack">
        <div>
          <h3>Install by URL</h3>
          <pre class="code-block"><code>{installCmd}</code></pre>
        </div>
        <div>
          <h3>Or register the namespace<span class="hint">components.json</span></h3>
          <pre class="code-block"><code>{installConfig}</code></pre>
          <p class="code-note">Then: <code>npx shadcn add @uiforagents/ocean-calm</code> (any slug works in place of <code>ocean-calm</code>).</p>
        </div>
      </div>
    </section>

    <section class="section" id="agents" aria-label="For agents">
      <div class="section-head">
        <p class="eyebrow">For agents</p>
        <h2>Every surface is machine-readable</h2>
        <p>Humans pick the identity; agents build with it. These surfaces are the whole integration - start from llms.txt.</p>
      </div>
      <div class="spec-grid">
        <div class="spec-card">
          <h3>llms.txt</h3>
          <p class="desc" style="font-size:14px;color:var(--text-muted);">The agent front door: the catalogue, install commands, and every surface in one index. Point any agent at it to bootstrap the workflow.</p>
          <a href="/llms.txt">Fetch llms.txt →</a>
        </div>
        <div class="spec-card">
          <h3>Agent prompt-pack</h3>
          <p class="desc" style="font-size:14px;color:var(--text-muted);">A markdown contract attached to every agent building UI: fonts, color rules, density, spacing, motion, and do/don'ts. It is the difference between "make it look nice" and a premium result.</p>
          <a href="/prompt-packs/ocean-calm.md">Read the ocean-calm pack raw →</a>
        </div>
        <div class="spec-card">
          <h3>shadcn registry payload</h3>
          <p class="desc" style="font-size:14px;color:var(--text-muted);">The machine-readable surface the shadcn CLI consumes: theme CSS, overrides, and composed blocks in one validated payload.</p>
          <a href="/registries/ocean-calm/ocean-calm.json">Inspect the registry payload →</a>
        </div>
        <div class="spec-card">
          <h3>Identity spec</h3>
          <p class="desc" style="font-size:14px;color:var(--text-muted);">identity.json is the source of record: tokens, block list, tested versions, license. Published as JSON for tooling.</p>
          <a href="/identities/ocean-calm.json">Fetch the identity spec →</a>
        </div>
      </div>
    </section>
  </div>
</Base>

<script>
  // Client-side catalogue filtering. State lives in the URL (q, lane, tag) so
  // filtered views are shareable; the DOM is fully rendered at build time.
  const grid = document.getElementById("identity-grid");
  const empty = document.getElementById("identity-empty");
  const count = document.getElementById("identity-count");
  const search = document.getElementById("identity-search") as HTMLInputElement | null;
  const clear = document.getElementById("identity-clear");
  if (grid && empty && count && search) {
    const tiles = Array.from(grid.querySelectorAll<HTMLElement>(".identity-tile"));
    const laneBtns = Array.from(document.querySelectorAll<HTMLButtonElement>(".lane-btn"));
    const tagBtns = Array.from(document.querySelectorAll<HTMLButtonElement>(".tag-btn"));
    const state = { q: "", lane: "all", tag: "" };

    const total = tiles.length;
    const noun = total === 1 ? "identity" : "identities";

    function apply() {
      let shown = 0;
      for (const tile of tiles) {
        const matchLane = state.lane === "all" || tile.dataset.lane === state.lane;
        const matchTag = !state.tag || (tile.dataset.tags ?? "").split(" ").includes(state.tag);
        const matchQ = !state.q || (tile.dataset.search ?? "").includes(state.q);
        const show = matchLane && matchTag && matchQ;
        tile.hidden = !show;
        if (show) shown++;
      }
      count.textContent =
        shown === total ? `Showing all ${total} ${noun}` : `Showing ${shown} of ${total} ${noun}`;
      empty.hidden = shown !== 0;
      laneBtns.forEach((b) => {
        const active = b.dataset.lane === state.lane;
        b.classList.toggle("is-active", active);
        b.setAttribute("aria-pressed", String(active));
      });
      tagBtns.forEach((b) => {
        const active = b.dataset.tag === state.tag;
        b.classList.toggle("is-active", active);
        b.setAttribute("aria-pressed", String(active));
      });
      const params = new URLSearchParams();
      if (state.q) params.set("q", state.q);
      if (state.lane !== "all") params.set("lane", state.lane);
      if (state.tag) params.set("tag", state.tag);
      const qs = params.toString();
      history.replaceState(null, "", qs ? `?${qs}` : location.pathname);
    }

    search.addEventListener("input", () => {
      state.q = search.value.trim().toLowerCase();
      apply();
    });
    laneBtns.forEach((b) =>
      b.addEventListener("click", () => {
        state.lane = b.dataset.lane ?? "all";
        apply();
      })
    );
    tagBtns.forEach((b) =>
      b.addEventListener("click", () => {
        state.tag = state.tag === b.dataset.tag ? "" : (b.dataset.tag ?? "");
        apply();
      })
    );
    clear?.addEventListener("click", () => {
      state.q = "";
      state.lane = "all";
      state.tag = "";
      search.value = "";
      apply();
    });

    const params = new URLSearchParams(location.search);
    state.q = (params.get("q") ?? "").toLowerCase();
    state.lane = params.get("lane") ?? "all";
    state.tag = params.get("tag") ?? "";
    search.value = state.q;
    apply();
  }
</script>
