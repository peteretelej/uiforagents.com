---
import Base from "../../layouts/Base.astro";
import ItemExample from "../../components/ItemExample.astro";
import { loadLlmsGroups } from "../../lib/kit.mjs";

const groups = loadLlmsGroups();
const count = groups.reduce((sum, g) => sum + g.items.length, 0);
---
<Base title="Components - uiforagents">
  <div class="page">
    <header class="page-head">
      <h1>Components</h1>
      <p>Every one of the {count} items, live, rendered in the current direction - flip the
      direction switcher to restyle everything in place. Each example links to its generated
      agent-facing docs; index lines come from <a href="/llms.txt">llms.txt</a>, the way an
      agent reads the kit.</p>
    </header>
    {groups.map((group) => (
      <section class="catalog-section">
        <h2 style={`text-transform: capitalize;`} id={`category-${group.category}`}>{group.category}</h2>
        {group.items.map((item) => (
          <section class="catalog-item" id={item.name}>
            <div class="catalog-head">
              <h3>{item.title}</h3>
              <span class="catalog-name">{item.name}</span>
              <a href={`/components/${item.name}/`}>Docs</a>
            </div>
            <p class="catalog-desc">{item.description}</p>
            <div class="catalog-stage">
              <ItemExample name={item.name} />
            </div>
          </section>
        ))}
      </section>
    ))}
  </div>
</Base>
