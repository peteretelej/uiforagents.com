---
import { getCollection, render } from "astro:content";
import Docs from "../../layouts/Docs.astro";
import ItemExample from "../../components/ItemExample.astro";
import { loadLlmsGroups } from "../../lib/kit.mjs";

const groups = loadLlmsGroups();

export async function getStaticPaths() {
  const entries = await getCollection("components");
  return entries.map((entry) => ({ params: { name: entry.id } }));
}

const entries = await getCollection("components");

const { name } = Astro.params;
const entry = entries.find((candidate) => candidate.id === name);
if (!entry) throw new Error(`no docs twin for ${name}`);
const line = groups.flatMap((g) => g.items).find((item) => item.name === name);
// Rendered docs twin. Its "Files" links point at the kit-relative item
// sources; the site publishes those same files at /items/ (agent surfaces).
// Headings come from render(); entry.rendered.headings is not populated
// for glob-loaded markdown.
const { headings } = await render(entry);
const html = entry.rendered.html.replaceAll("(../../items/", "(/items/");
---
<Docs
  title={`${line ? line.title : name} - uiforagents components`}
  description={line?.description ?? ""}
  toc={headings}
  crumbs={[
    { label: "Components", href: "/components/" },
    { label: line ? line.title : name },
  ]}
>
  <article class="prose" set:html={html} />
  <section class="catalog-section" style="margin-top: calc(var(--space) * 5);">
    <h2 id="live-example">Live example</h2>
    <p>Rendered from the copied item files under <code>src/ui/</code>; restyle it with the direction switcher.</p>
    <div class="catalog-item">
      <div class="catalog-stage">
        <ItemExample name={name} />
      </div>
    </div>
  </section>
</Docs>
