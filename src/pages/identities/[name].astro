---
import { getEntry, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { loadIdentities } from "../../lib/identities.mjs";
import { getBlocks } from "../../lib/blocks";
import { Button } from "../../components/ui/button";
import { Badge } from "../../components/ui/badge";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "../../components/ui/card";
import { Input } from "../../components/ui/input";
import { Label } from "../../components/ui/label";
import "../../styles/identity.generated.css";

// Artifact-lane identities do not get a page from this template: their
// identity page IS their demo document, published by
// scripts/publish-identities.mjs straight from demo.html. This template
// renders React-lane identities only, where the page is the shared demo app
// themed by the identity.
export function getStaticPaths() {
  return loadIdentities()
    .filter((identity) => identity.lane === "react")
    .map((identity) => ({
      params: { name: identity.slug },
      props: { identity },
    }));
}

const { identity } = Astro.props;
const { spec, slug } = identity;
const {
  Hero,
  AuthCard,
  DashboardShell,
  TablePage,
  Article,
} = getBlocks(slug);

// Counts and claims on this page derive from data - the catalogue loaders
// and the identity spec (identity.json is the source of record) - so adding
// an identity, primitive, or block updates the copy without editing it.
const identityCount = loadIdentities().length;
const suitePrimitives = ["Button", "Badge", "Card", "Input", "Label"];
const blockList = spec.blocks;
if (!Array.isArray(blockList) || blockList.length === 0) {
  throw new Error(`Identity "${slug}" declares no block list in identity.json`);
}
const countNoun = (n, singular) => `${n} ${n === 1 ? singular : singular}s`;
const suiteCount = suitePrimitives.length + blockList.length;

const pack = await getEntry("promptPacks", slug);
const { Content: PromptPack } = await render(pack);

// States gallery: interactive rows are live specimens - the same control row
// rendered in each state, so the row itself demonstrates the state - and the
// frozen row derives its controls from the same flag. Row count and copy
// derive from this data; every React identity page inherits the section.
const interactiveStates = [
  { name: "Hover", hint: "point at one", frozen: false },
  { name: "Focus", hint: "tab into one", frozen: false },
  { name: "Active", hint: "press and hold", frozen: false },
  { name: "Disabled", hint: "frozen, non-interactive", frozen: true },
];

// uiforagents-branded sample content, identical across identities. Blocks
// with prop surfaces take their content from here.
const brand = {
  eyebrow: "uiforagents",
  title: "Design identities for",
  accent: "agent-built apps",
  description:
    "Complete, opinionated design systems on shadcn/ui. Pick an identity, install it with one command, and hand your agent the prompt-pack - no design decisions left to make.",
  primaryCta: "Pick an identity",
  secondaryCta: "See the suite",
  stats: [
    { value: String(identityCount), label: identityCount === 1 ? "identity" : "identities" },
    { value: String(suiteCount), label: `${countNoun(suiteCount, "component")} each` },
    { value: "2,580", label: "installs" },
    { value: "3,418", label: "agent builds" },
  ],
};

const shellNav = [
  { label: "Identities", active: true },
  { label: "Prompt-packs" },
  { label: "Registry" },
];
const catalogueNav = [
  { label: "Overview" },
  { label: "Catalogue", active: true },
  { label: "Prompt-packs" },
  { label: "Registry" },
];
const catalogueColumns = ["Code", "Kind", "Identity", "Status", "Usage"];
const catalogueJobs = [
  { code: "ID-01", trade: "Identity", customer: "ocean-calm", status: "Live", tone: "ok", price: "1,024 installs" },
  { code: "ID-02", trade: "Identity", customer: "nairobi-noon", status: "Live", tone: "ok", price: "864 installs" },
  { code: "ID-03", trade: "Identity", customer: "graphite-terminal", status: "Live", tone: "ok", price: "692 installs" },
  { code: "ID-04", trade: "Agent build", customer: "prompt-pack driven", status: "Passing", tone: "ok", price: "3,418 runs" },
];
const catalogueServices = [
  { id: "ID-01", service: "Identity", owner: "ocean-calm", status: "Live", tone: "ok", p99: "1,024 installs" },
  { id: "ID-02", service: "Identity", owner: "nairobi-noon", status: "Live", tone: "ok", p99: "864 installs" },
  { id: "ID-03", service: "Identity", owner: "graphite-terminal", status: "Live", tone: "ok", p99: "692 installs" },
  { id: "ID-04", service: "Agent build", owner: "prompt-pack driven", status: "Passing", tone: "ok", p99: "3,418 runs" },
];

const installCmd = `npx shadcn add https://uiforagents.com/r/${slug}.json`;
const installConfig = JSON.stringify(
  {
    registries: {
      "@uiforagents": "https://uiforagents.com/r/{name}.json",
    },
  },
  null,
  2
);
const installNote =
  slug === "nairobi-noon"
    ? "Verified behavior: this payload declares no registry dependencies - it adds the theme, blocks, and prompt-pack only. If your project lacks the stock primitives, add them first: npx shadcn add button card badge input label."
    : "Verified behavior: this also installs the stock shadcn primitives (button, card, badge, input, label) from the default registry, then adds the theme, blocks, and prompt-pack under src/identities/" + slug + "/.";

const blockNotes = {
  hero: "Marketing landing section",
  auth: "Sign-in and sign-up surface",
  "dashboard-shell": "Topbar + stats app frame",
  "table-page": "Data table with filters and row states",
  article: "Long-form reading layout",
};

const tested = spec.stack?.tested ?? {};
const stackRows = [
  ["base", spec.stack?.base],
  ["primitives", spec.stack?.primitives],
  ["tailwind", spec.stack?.tailwind],
  ["react", spec.stack?.react],
].filter(([, value]) => Boolean(value));
---
<Base title={`${spec.title} - uiforagents identity`} description={spec.description} identity={{ slug, lane: identity.lane }}>
  <div class="mx-auto max-w-[1120px] px-6">
      <header class="pt-12">
        <p class="text-[12px] font-extrabold uppercase tracking-[0.16em] text-primary">Identity</p>
        <h1 class="mt-3 font-display text-[clamp(32px,4.5vw,44px)] font-extrabold leading-[1.08] tracking-[-0.03em]">{spec.title}</h1>
        <p class="mt-3 max-w-[62ch] text-[16px] leading-relaxed text-muted-foreground">{spec.description}</p>
        <div class="mt-4 flex flex-wrap gap-2">
          {spec.vibe.map((tag) => (
            <Badge variant="secondary" className="rounded-full px-3 py-1 text-[12px]">{tag}</Badge>
          ))}
        </div>
                  <p class="mt-5 flex flex-wrap gap-x-5 gap-y-1 text-[13px] text-muted-foreground">
            <span><strong class="font-semibold text-foreground">v</strong>{spec.version}</span>
            <span><strong class="font-semibold text-foreground">registry</strong> {spec.registry}</span>
            <span><strong class="font-semibold text-foreground">license</strong> {spec.license}</span>
          </p>
        
              </header>

      {/* Cross-identity navigation lives in the floating catalogue chrome
          (search, prev/next, about drawer) - the page itself is only about
          this identity. */}

            <section class="pt-14" aria-label="UI primitives">
        <p class="text-[12px] font-extrabold uppercase tracking-[0.16em] text-primary">The suite</p>
        <h2 class="mt-2 font-display text-[26px] font-bold tracking-[-0.02em]">UI primitives, live</h2>
        <p class="mt-1.5 max-w-[62ch] text-[15px] text-muted-foreground">The {countNoun(suitePrimitives.length, "shadcn primitive")} this identity ships - same components, its tokens and treatments.</p>
        <div class="mt-5 grid gap-4 md:grid-cols-2">
          <div class="rounded-[14px] border border-border bg-card p-6">
            <h3 class="font-display text-[16px] font-bold">Button</h3>
            <div class="mt-3 flex flex-wrap items-center gap-2.5">
              <Button size="sm">Default</Button>
              <Button size="sm" variant="secondary">Secondary</Button>
              <Button size="sm" variant="outline">Outline</Button>
              <Button size="sm" variant="ghost">Ghost</Button>
              <Button size="sm" variant="destructive">Destructive</Button>
              <Button size="sm" variant="link">Link</Button>
            </div>
          </div>
          <div class="rounded-[14px] border border-border bg-card p-6">
            <h3 class="font-display text-[16px] font-bold">Badge</h3>
            <div class="mt-3 flex flex-wrap items-center gap-2.5">
              <Badge>Default</Badge>
              <Badge variant="secondary">Secondary</Badge>
              <Badge variant="outline">Outline</Badge>
              <Badge variant="destructive">Destructive</Badge>
            </div>
          </div>
          <div class="rounded-[14px] border border-border bg-card p-6">
            <h3 class="font-display text-[16px] font-bold">Card</h3>
            <Card className="mt-3 rounded-xl">
              <CardHeader>
                <CardTitle className="font-display text-[15px] font-bold">Registry payload</CardTitle>
                <CardDescription>Theme, overrides, blocks, and prompt-pack in one install.</CardDescription>
              </CardHeader>
              <CardContent>
                <Badge variant="secondary">registry:style</Badge>
              </CardContent>
            </Card>
          </div>
          <div class="rounded-[14px] border border-border bg-card p-6">
            <h3 class="font-display text-[16px] font-bold">Input + Label</h3>
            <div class="mt-3 grid gap-3">
              <div class="grid gap-1.5">
                <Label for="suite-email">Email</Label>
                <Input id="suite-email" type="text" placeholder="you@agency.dev" />
              </div>
              <div class="grid gap-1.5">
                <Label for="suite-key">API key</Label>
                <Input id="suite-key" type="password" placeholder="••••••••" />
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="states-gallery" class="pt-14" aria-label="States gallery">
        <p class="text-[12px] font-extrabold uppercase tracking-[0.16em] text-primary">The suite</p>
        <h2 class="mt-2 font-display text-[26px] font-bold tracking-[-0.02em]">States, live</h2>
        <p class="mt-1.5 max-w-[62ch] text-[15px] text-muted-foreground">
          Every state the {countNoun(suitePrimitives.length, "shadcn primitive")} ship with, wearing this identity's
          treatments. Hover, tab into, and press the live rows; the data states below are frozen.
        </p>

        <div class="mt-5 grid gap-4 md:grid-cols-2">
          {interactiveStates.map((state) => (
            <div class="rounded-[14px] border border-border bg-card p-6">
              <div class="flex items-baseline justify-between gap-3">
                <h3 class="font-display text-[16px] font-bold">{state.name}</h3>
                <span class="font-mono text-[11px] uppercase tracking-[0.1em] text-muted-foreground">{state.hint}</span>
              </div>
              <div class="mt-4 flex flex-wrap items-center gap-2.5">
                <Button size="sm" disabled={state.frozen}>Continue</Button>
                <Button size="sm" variant="outline" disabled={state.frozen}>Cancel</Button>
                <a
                  href="#states-gallery"
                  class={`text-[13.5px] font-semibold text-primary underline underline-offset-4 ${state.frozen ? "pointer-events-none opacity-50" : ""}`}
                >Read the guide</a>
                <Input class="w-44" placeholder="you@agency.dev" aria-label={`${state.name} state input`} disabled={state.frozen} />
                {state.frozen && <Badge variant="outline">Read-only</Badge>}
              </div>
            </div>
          ))}
        </div>

        <div class="mt-4 grid gap-4 md:grid-cols-3">
          <div class="rounded-[14px] border border-border bg-card p-6">
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="font-display text-[16px] font-bold">Empty</h3>
              <span class="font-mono text-[11px] uppercase tracking-[0.1em] text-muted-foreground">nothing yet · offer the action</span>
            </div>
            <div class="py-8 text-center">
              <p class="font-display text-[15px] font-bold">No builds yet</p>
              <p class="mx-auto mt-1.5 max-w-[32ch] text-[13px] leading-relaxed text-muted-foreground">Runs land here the moment an agent ships with an identity.</p>
              <Button size="sm" class="mt-4">Run a build</Button>
            </div>
          </div>
          <div class="rounded-[14px] border border-border bg-card p-6">
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="font-display text-[16px] font-bold">Loading</h3>
              <span class="font-mono text-[11px] uppercase tracking-[0.1em] text-muted-foreground">skeleton rows · chrome stays put</span>
            </div>
            <div class="py-8">
              <div class="space-y-3">
                <div class="h-3 w-full animate-pulse rounded bg-secondary motion-reduce:animate-none" />
                <div class="h-3 w-4/5 animate-pulse rounded bg-secondary motion-reduce:animate-none" />
                <div class="h-3 w-3/5 animate-pulse rounded bg-secondary motion-reduce:animate-none" />
              </div>
              <p class="mt-4 font-mono text-[11px] uppercase tracking-[0.1em] text-muted-foreground">Fetching registry payload</p>
            </div>
          </div>
          <div class="rounded-[14px] border border-border bg-card p-6">
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="font-display text-[16px] font-bold">Error</h3>
              <span class="font-mono text-[11px] uppercase tracking-[0.1em] text-muted-foreground">say what failed · offer the retry</span>
            </div>
            <div class="py-8">
              <p class="font-display text-[15px] font-bold text-destructive">Registry sync failed</p>
              <p class="mt-1.5 font-mono text-[12px] text-muted-foreground">upstream_timeout · retry 2 of 3</p>
              <Button size="sm" variant="outline" class="mt-4">Retry now</Button>
            </div>
          </div>
        </div>
      </section>

      
          </div>

        <section class="pt-14" aria-label="Blocks">
      <div class="mx-auto max-w-[1120px] px-6">
        <p class="text-[12px] font-extrabold uppercase tracking-[0.16em] text-primary">The suite</p>
        <h2 class="mt-2 font-display text-[26px] font-bold tracking-[-0.02em]">Blocks, rendered live</h2>
        <p class="mt-1.5 max-w-[62ch] text-[15px] text-muted-foreground">The {countNoun(blockList.length, "block")} every install ships, server-rendered in this identity with uiforagents content.</p>
      </div>

      <div class="mx-auto max-w-[1120px] px-6 pt-8">
        <p class="font-mono text-[12px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">block · hero</p>
        <p class="mt-0.5 text-[13px] text-muted-foreground">{blockNotes.hero}</p>
      </div>
      <!-- Block demos carry their own internal gutters (px-6); the frame adds
           none, so content aligns identically at every breakpoint. -->
      <div class="mt-3 rounded-[14px] border border-border bg-card mx-auto max-w-[1120px] overflow-hidden">
        <Hero
          eyebrow={brand.eyebrow}
          title={brand.title}
          accent={brand.accent}
          description={brand.description}
          primaryCta={brand.primaryCta}
          secondaryCta={brand.secondaryCta}
          stats={brand.stats}
        />
      </div>

      <div class="mx-auto max-w-[1120px] px-6 pt-8">
        <p class="font-mono text-[12px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">block · auth</p>
        <p class="mt-0.5 text-[13px] text-muted-foreground">{blockNotes.auth}</p>
        <div class="mt-3 flex justify-center rounded-[14px] border border-border bg-card px-6 py-8">
          <AuthCard
            title="Sign in to uiforagents"
            description="Agent-built apps deserve agent-grade design."
            primaryCta="Sign in"
          />
        </div>
      </div>

      <div class="pt-8">
        <div class="mx-auto max-w-[1120px] px-6">
          <p class="font-mono text-[12px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">block · dashboard-shell</p>
          <p class="mt-0.5 text-[13px] text-muted-foreground">{blockNotes["dashboard-shell"]}</p>
        </div>
        <div class="mt-3 border-y border-border bg-card overflow-x-auto">
          <DashboardShell title="uiforagents" nav={shellNav} stats={brand.stats}>
            <div class="grid gap-4 lg:grid-cols-3">
              <Card className="rounded-xl px-5 py-4">
                <CardTitle className="font-display text-[16px] font-bold">Prompt-pack driven</CardTitle>
                <CardDescription className="mt-1.5">Every identity ships the agent contract alongside the theme.</CardDescription>
              </Card>
              <Card className="rounded-xl px-5 py-4">
                <CardTitle className="font-display text-[16px] font-bold">Blocks included</CardTitle>
                <CardDescription className="mt-1.5">{countNoun(blockList.length, "composed section")}, content adapted per project.</CardDescription>
              </Card>
              <Card className="rounded-xl px-5 py-4">
                <CardTitle className="font-display text-[16px] font-bold">Tokens, not forks</CardTitle>
                <CardDescription className="mt-1.5">Brand happens via tokens and overrides - never per-project restyles.</CardDescription>
              </Card>
            </div>
          </DashboardShell>
        </div>
      </div>

      <div class="pt-8">
        <div class="mx-auto max-w-[1120px] px-6">
          <p class="font-mono text-[12px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">block · table-page</p>
          <p class="mt-0.5 text-[13px] text-muted-foreground">{blockNotes["table-page"]}</p>
        </div>
        <div class="mt-3 border-y border-border bg-card overflow-x-auto">
          {slug === "graphite-terminal" ? (
            <TablePage
              title="uiforagents"
              nav={catalogueNav}
              stats={brand.stats}
              heading="Catalogue"
              columns={catalogueColumns}
              rows={catalogueServices}
            />
          ) : (
            <TablePage
              title="uiforagents"
              nav={catalogueNav}
              stats={brand.stats}
              heading="Catalogue"
              columns={catalogueColumns}
              rows={catalogueJobs}
            />
          )}
        </div>
      </div>

      <div class="mx-auto max-w-[1120px] px-6 pt-8">
        <p class="font-mono text-[12px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">block · article</p>
        <p class="mt-0.5 text-[13px] text-muted-foreground">{blockNotes.article}</p>
        <div class="mt-3 rounded-[14px] border border-border bg-card">
          <Article
            eyebrow="Guide"
            title="Ship an agent-built app with an identity"
            meta="uiforagents guide · updated October 2026"
          >
            <p>An identity is a complete design system: tokens, component treatments, blocks, and the prompt-pack your agent follows. Installation is one command; from there the design decisions are already made.</p>
            <h2>Three steps</h2>
            <ul>
              <li>Pick an identity and install it by URL with the shadcn CLI.</li>
              <li>Import the theme after Tailwind and set <strong>data-identity</strong> on your root element.</li>
              <li>Attach the prompt-pack to every agent building UI - it is the binding contract.</li>
            </ul>
            <blockquote>Brand happens via tokens and overrides, never per-project restyling.</blockquote>
            <p>Start from the blocks, adapt the content, and ship. The suite on this page is everything the identity installs.</p>
          </Article>
        </div>
      </div>
    </section>
    

    <div class="mx-auto max-w-[1120px] px-6 pb-16">
            <section class="pt-14" aria-label="Manual install">
        <p class="text-[12px] font-extrabold uppercase tracking-[0.16em] text-primary">Manual install</p>
        <h2 class="mt-2 font-display text-[26px] font-bold tracking-[-0.02em]">Add {slug} to your app</h2>
        <p class="mt-1.5 text-[15px] text-muted-foreground">For a seamless experience, consider <a class="font-semibold text-primary underline underline-offset-4" href="/#how">installing the agent skill</a> - it picks the identity and runs the install for you. Everything below is the manual path.</p>
        <div class="mt-5 grid gap-5 lg:grid-cols-2">
          <div class="min-w-0">
            <h3 class="font-display text-[15px] font-bold">Install by URL</h3>
            <pre class="mt-2 overflow-x-auto rounded-[12px] border border-border bg-card p-4 font-mono text-[13px] leading-relaxed"><code>{installCmd}</code></pre>
            <p class="mt-2 text-[13px] leading-relaxed text-muted-foreground">{installNote}</p>
          </div>
          <div class="min-w-0">
            <h3 class="font-display text-[15px] font-bold">Or register the namespace<span class="ml-2 rounded-full border border-border px-2 py-0.5 text-[12px] font-mono font-normal text-muted-foreground">components.json</span></h3>
            <pre class="mt-2 overflow-x-auto rounded-[12px] border border-border bg-card p-4 font-mono text-[13px] leading-relaxed"><code>{installConfig}</code></pre>
            <p class="mt-2 text-[13px] leading-relaxed text-muted-foreground">Then: <code class="rounded border border-border bg-secondary px-1.5 py-0.5 font-mono text-[12px]">npx shadcn add @uiforagents/{slug}</code>. Import the theme in your global CSS after Tailwind, per the registry payload.</p>
          </div>
        </div>
      </section>
      

      <section class="pt-14" aria-label="Agent prompt-pack">
        <p class="text-[12px] font-extrabold uppercase tracking-[0.16em] text-primary">Agent prompt-pack</p>
        <h2 class="mt-2 font-display text-[26px] font-bold tracking-[-0.02em]">The contract your agent follows</h2>
        <p class="mt-1.5 text-[15px] text-muted-foreground">Attach <a class="font-semibold text-primary underline underline-offset-4" href={`/prompt-packs/${slug}.md`}>prompt-pack.md</a> (raw) to every agent building UI with this identity.</p>
        <div class="prompt-pack mt-5 rounded-[14px] border border-border bg-card p-6 lg:p-8">
          <PromptPack />
        </div>
      </section>

            <section class="pt-14" aria-label="Spec and license">
        <p class="text-[12px] font-extrabold uppercase tracking-[0.16em] text-primary">Spec</p>
        <h2 class="mt-2 font-display text-[26px] font-bold tracking-[-0.02em]">Versions, stack, license</h2>
        <div class="mt-5 grid gap-4 md:grid-cols-3">
          <Card className="rounded-[14px]">
            <CardHeader>
              <CardTitle className="font-display text-[15px] font-bold">Tested versions</CardTitle>
            </CardHeader>
            <CardContent>
              <dl class="grid gap-1.5 text-[13.5px]">
                {Object.entries(tested).map(([k, v]) => (
                  <div class="flex items-baseline justify-between gap-3">
                    <dt class="font-mono text-[12px] text-muted-foreground">{k}</dt>
                    <dd class="text-right">{v}</dd>
                  </div>
                ))}
              </dl>
            </CardContent>
          </Card>
          <Card className="rounded-[14px]">
            <CardHeader>
              <CardTitle className="font-display text-[15px] font-bold">Stack</CardTitle>
            </CardHeader>
            <CardContent>
              <dl class="grid gap-1.5 text-[13.5px]">
                {stackRows.map(([k, v]) => (
                  <div class="flex items-baseline justify-between gap-3">
                    <dt class="font-mono text-[12px] text-muted-foreground">{k}</dt>
                    <dd class="text-right">{v}</dd>
                  </div>
                ))}
              </dl>
            </CardContent>
          </Card>
          <Card className="rounded-[14px]">
            <CardHeader>
              <CardTitle className="font-display text-[15px] font-bold">License</CardTitle>
            </CardHeader>
            <CardContent>
              <p class="text-[13.5px] leading-relaxed text-muted-foreground">
                {spec.license}. Upstream: shadcn (MIT), Tailwind (MIT), Base UI (MIT) - notices flow through to consumers.
              </p>
              <a href="/about/#license" class="mt-3 inline-block text-[13.5px] font-semibold text-primary underline underline-offset-4">License details →</a>
            </CardContent>
          </Card>
        </div>
      </section>
      
    </div>

  <style is:global>
    /* Font utilities resolve through the active identity's own tokens, not
       the merged @theme mapping (all identity themes share one stylesheet). */
    [data-identity] .font-display { font-family: var(--font-display); }
    [data-identity] .font-sans { font-family: var(--font-sans); }
    [data-identity] .font-mono { font-family: var(--font-mono); }

    /* Prompt-pack prose, token-styled (markdown renders without scope attrs).
       Type scale is deliberately tighter than page headings so the pack reads
       as a dense contract, not a second page. */
    .prompt-pack { font-size: 14.5px; line-height: 1.6; }
    .prompt-pack h1 { font-family: var(--font-display); font-size: 20px; letter-spacing: -0.01em; }
    .prompt-pack h2 { font-family: var(--font-display); font-size: 17px; margin: 1.3rem 0 0.4rem; letter-spacing: -0.01em; }
    .prompt-pack h3 { font-family: var(--font-display); font-size: 15px; margin: 1rem 0 0.35rem; }
    .prompt-pack p { margin: 0.55rem 0; }
    .prompt-pack ul, .prompt-pack ol { margin: 0.55rem 0 0.55rem 1.25rem; }
    .prompt-pack ul { list-style: disc; }
    .prompt-pack ol { list-style: decimal; }
    .prompt-pack li { margin: 0.25rem 0; }
    .prompt-pack strong { font-weight: 600; }
    .prompt-pack code { font-family: var(--font-mono); font-size: 0.85em; background: var(--secondary); border: 1px solid var(--border); border-radius: 6px; padding: 0.1em 0.35em; }
    .prompt-pack pre { border: 1px solid var(--border); border-radius: 12px; padding: 14px 16px; overflow-x: auto; margin: 0.85rem 0; }
    .prompt-pack pre code { background: none; border: none; padding: 0; font-size: 13px; }
    .prompt-pack a { color: var(--primary); text-decoration: underline; text-underline-offset: 3px; }
    .prompt-pack blockquote { border-left: 3px solid var(--primary); padding-left: 14px; color: var(--muted-foreground); margin: 0.85rem 0; }
    .prompt-pack hr { border: 0; border-top: 1px solid var(--border); margin: 1.3rem 0; }
    .prompt-pack table { width: 100%; border-collapse: collapse; margin: 0.85rem 0; font-variant-numeric: tabular-nums; font-size: 13px; }
    .prompt-pack th, .prompt-pack td { border: 1px solid var(--border); padding: 6px 10px; text-align: left; }

    /* Scroll affordance for every code surface in the identity scope: thin
       scrollbar always; right-edge fade ONLY while the block overflows
       (scroll-state query), so fitting code is never faded. */
    [data-identity] pre { scrollbar-width: thin; scrollbar-color: var(--border) transparent; container-type: scroll-state; }
    @container scroll-state(scrollable: inline-end) {
      [data-identity] pre > code { mask-image: linear-gradient(to right, #000 calc(100% - 24px), transparent); }
    }
  </style>

  <link rel="stylesheet" href="/chrome/identity-chrome.css">
  <div
    class="ufa-chrome"
    data-slug={slug}
    data-lane="react"
    data-title={spec.title}
    data-description={spec.description}
    data-vibe={spec.vibe.join(",")}
    data-lead={identity.leadScheme}
    data-version={spec.version}
    data-license={spec.license}
    data-install={installCmd}
  >
  </div>
  <script is:inline src="/chrome/identity-chrome.js" defer></script>
</Base>
