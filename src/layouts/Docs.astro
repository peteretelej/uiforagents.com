---
// Docs chrome: kit sidebar nav, breadcrumbs, and an optional TOC rail.
import Base from "./Base.astro";
import { loadLlmsGroups } from "../lib/kit.mjs";

const { title, description, crumbs = [], toc = [] } = Astro.props;
const groups = loadLlmsGroups();
const path = Astro.url.pathname.replace(/\/+$/, "") + "/";
---
<Base title={title} description={description}>
  <div class="docs-shell">
    <aside class="docs-sidebar">
      <nav class="uif-sidebar" data-variant="panel" aria-label="Components">
        <a data-slot="link" href="/components/" aria-current={path === "/components/" ? "page" : undefined}>Overview</a>
        {groups.map((group) => (
          <div data-slot="group">
            <span data-slot="heading">{group.category}</span>
            {group.items.map((item) => (
              <a data-slot="link" href={`/components/${item.name}/`} aria-current={path === `/components/${item.name}/` ? "page" : undefined}>
                {item.title}
              </a>
            ))}
          </div>
        ))}
      </nav>
    </aside>
    <div class="docs-body">
      {crumbs.length > 0 && (
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          {crumbs.map((crumb) =>
            crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span data-slot="current">{crumb.label}</span>
          )}
        </nav>
      )}
      <slot />
    </div>
    {toc.length > 0 && (
      <aside class="docs-toc">
        <h2>On this page</h2>
        <ul>
          {toc.filter((heading) => heading.depth >= 2).map((heading) => (
            <li class={`toc-depth-${heading.depth}`}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </div>
</Base>
