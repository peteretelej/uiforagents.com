---
// Live embed of a copied kit item: markup plus its js-inline behavior,
// straight from the generated copies under src/ui (never hand-edited).
import { readFileSync } from "node:fs";
import { fileURLToPath, pathToFileURL } from "node:url";

const { name } = Astro.props;
const siteRoot = fileURLToPath(pathToFileURL(process.cwd().replace(/\/?$/, "/")));
const itemDir = `${siteRoot}src/ui/${name}/`;
const markup = readFileSync(`${itemDir}${name}.html`, "utf8").trim();
const manifest = JSON.parse(readFileSync(`${siteRoot}../uiforagents/items/${name}/item.json`, "utf8"));
const behavior = manifest.files
  .filter((f) => f.type === "kit:behavior")
  .map((f) => readFileSync(`${itemDir}${f.path}`, "utf8").trim());
---
<div class="item-embed" data-item={name}>
  <Fragment set:html={markup} />
</div>
<!-- Behavior scripts are classic inline scripts, which share the global
     lexical scope; the catalog page embeds several on one page and their
     top-level names collide (toast/audio-player both declared `timer`).
     Wrap each in an IIFE so every embed keeps its own scope. -->
{behavior.map((code) => <script is:inline set:html={`(() => {\n${code}\n})();`} />)}
