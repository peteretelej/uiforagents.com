---
// Compact catalogue card: the whole inventory in one scannable grid. Carries
// the identity's own color like IdentityCard, with a short description so
// cards stand alone; the identity page owns the long form. data-*
// attributes drive the client-side filter bar on the index page.
const { identity } = Astro.props;

const style = [
  `color-scheme:${identity.leadScheme}`,
  `--id-accent:${identity.palette.primary}`,
  `--id-gradient-to:${identity.palette["identity-gradient-to"]}`,
].join(";");
const haystack = [identity.spec.title, identity.spec.description, identity.lane, ...identity.spec.vibe]
  .join(" ")
  .toLowerCase();
---
<a
  class="identity-tile"
  href={`/identities/${identity.slug}/`}
  style={style}
  data-lane={identity.lane}
  data-tags={identity.spec.vibe.join(" ")}
  data-search={haystack}
>
  <span class="tile-swatch" aria-hidden="true"></span>
  <span class="tile-body">
    <span class="tile-name">{identity.spec.title}</span>
    <span class="tile-desc">{identity.spec.description}</span>
    <span class="tile-meta">
      {identity.lane === "artifact" && <span class="tile-lane">artifact</span>}
      {identity.spec.vibe.map((tag) => <span class="tile-tag">{tag}</span>)}
    </span>
    <span class="tile-go">Open identity →</span>
  </span>
</a>
